rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'createdAt'])
          && data.keys().size() == 3
          && data.email is string
          && data.email.size() <= 256
          && data.name is string
          && data.name.size() <= 128
          && data.createdAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.name is string && data.name.size() <= 128;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidId(userId)
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name'])
                    && isValidUserUpdate(incoming());
      allow delete: if false;

      match /vcm_ledger/{entryId} {
        function isValidLedgerEntry(data) {
          return data.keys().hasAll(['nodeId', 'timestamp', 'hash', 'metrics', 'creditMinted', 'status', 'userId'])
              && data.keys().size() == 7
              && data.nodeId is string && data.nodeId.size() <= 64
              && data.timestamp is string && data.timestamp.size() <= 64
              && data.hash is string && data.hash.size() <= 128
              && data.metrics is map
              && data.creditMinted is number
              && data.status is string && data.status.size() <= 32
              && data.userId == request.auth.uid;
        }

        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId 
                      && isValidId(userId)
                      && isValidId(entryId)
                      && isValidLedgerEntry(incoming())
                      && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if false;
      }
    }

    match /telemetry/{telemetryId} {
      function isValidTelemetryPoint(data) {
        return data.keys().hasAll(['nodeId', 'timestamp', 'metrics'])
            && data.keys().size() == 3
            && data.nodeId is string && data.nodeId.size() <= 64
            && data.timestamp is string && data.timestamp.size() <= 64
            && data.metrics is map;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(telemetryId)
                    && isValidTelemetryPoint(incoming());
      allow update, delete: if false;
    }

    match /agronomy_profiles/{nodeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
