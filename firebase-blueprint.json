{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the NexusLIMS platform.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "name": {
          "type": "string",
          "description": "User's display name"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of account creation"
        }
      },
      "required": ["email", "name", "createdAt"]
    },
    "TelemetryPoint": {
      "title": "TelemetryPoint",
      "description": "A telemetry record from an edge node.",
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The ID of the edge node"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the reading"
        },
        "metrics": {
          "type": "object",
          "description": "The collected metrics"
        }
      },
      "required": ["nodeId", "timestamp", "metrics"]
    },
    "VcmLedgerEntry": {
      "title": "VcmLedgerEntry",
      "description": "An immutable record of VCM credit minting.",
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The ID of the edge node"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the event"
        },
        "hash": {
          "type": "string",
          "description": "Cryptographic hash of the telemetry batch"
        },
        "metrics": {
          "type": "object",
          "description": "The metrics that triggered the minting"
        },
        "creditMinted": {
          "type": "number",
          "description": "The amount of NXT credits minted"
        },
        "status": {
          "type": "string",
          "description": "Status of the ledger entry"
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this record"
        }
      },
      "required": ["nodeId", "timestamp", "hash", "metrics", "creditMinted", "status", "userId"]
    },
    "AgronomyProfile": {
      "title": "AgronomyProfile",
      "description": "Cached baseline soil and agronomy metrics for a geographic coordinate or hardware node.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the agronomy profile document" },
        "nodeId": { "type": "string", "description": "Associated hardware node ID if applicable" },
        "lat": { "type": "number", "description": "Latitude coordinate" },
        "lon": { "type": "number", "description": "Longitude coordinate" },
        "faoClassification": { "type": "string", "description": "FAO soil classification" },
        "phBaseline": { "type": "number", "description": "Baseline soil pH (H2O)" },
        "cecRatio": { "type": "number", "description": "Cation Exchange Capacity (cmol(+)/kg)" },
        "soilMoistureIndex": { "type": "number", "description": "Calculated soil moisture index" },
        "electricalConductivity": { "type": "number", "description": "Electrical conductivity in dS/m" },
        "bulkDensity": { "type": "number", "description": "Bulk density in g/cm3" },
        "soilComposition": {
          "type": "object",
          "description": "Soil texture components (sand, silt, clay, organic carbon)"
        },
        "nutrients": {
          "type": "object",
          "description": "Macronutrient content (N, P, K)"
        },
        "lastSyncedAt": { "type": "string", "description": "Server timestamp of last sync" },
        "source": { "type": "string", "description": "Data provider source" }
      },
      "required": ["id", "lat", "lon", "phBaseline", "cecRatio", "soilComposition", "nutrients"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/telemetry/{telemetryId}": {
      "schema": { "$ref": "#/entities/TelemetryPoint" },
      "description": "Global telemetry points stream"
    },
    "/users/{userId}/vcm_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/VcmLedgerEntry" },
      "description": "VCM ledger entries for a specific user"
    },
    "/agronomy_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/AgronomyProfile" },
      "description": "Cached agronomy soil profiles"
    }
  }
}
