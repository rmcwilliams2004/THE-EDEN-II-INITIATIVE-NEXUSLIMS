datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ENTERPRISE_ADMIN
  NGO_COORDINATOR
  AGRONOMIST
  FARMER
}

enum NodeType {
  COMMERCIAL_40FT
  HUMANITARIAN_20FT
}

enum NodeStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  EMERGENCY_STOP
  PURGING
}

enum CropType {
  MAIZE
  COFFEE
  WHEAT
  CORN
  SOYBEAN
  CUSTOM
}

enum TokenStatus {
  PENDING
  MINTED
  RETIRED
  TRADED
}

enum SafetyEventType {
  OVERPRESSURE
  H2_LEAK
  NH3_SCRUBBER_ENGAGED
  EMERGENCY_PURGE
  FOLIAR_LOCKOUT_TRIPPED
}

enum OrgType {
  ENTERPRISE
  NGO
  COOPERATIVE
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  role            UserRole        @default(FARMER)
  firstName       String
  lastName        String
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id])
  rfidCardId      String?         @unique
  hederaAccountId String?
  dispenseEvents  DispenseEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([role])
  @@index([rfidCardId])
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  type            OrgType   @default(ENTERPRISE)
  taxId           String?
  hederaAccountId String?
  users           User[]
  nodes           Node[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Node {
  id                    String          @id @default(uuid())
  serialNumber          String          @unique
  modelType             NodeType        @default(COMMERCIAL_40FT)
  status                NodeStatus      @default(ONLINE)
  lat                   Float
  lng                   Float
  country               String          @default("United States")
  organizationId        String?
  organization          Organization?   @relation(fields: [organizationId], references: [id])
  sisterNodeId          String?
  ruthenimBedCapacityKg Float           @default(150.0)
  electrolyzerKw        Float           @default(300.0)
  firmWareVersion       String          @default("v3.2.1-sil3")
  lastHeartbeatAt       DateTime        @default(now())
  dispenseEvents        DispenseEvent[]
  safetyLogs            SIL3SafetyLog[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status])
  @@index([serialNumber])
}

model DispenseEvent {
  id                   String        @id @default(uuid())
  nodeId               String
  node                 Node          @relation(fields: [nodeId], references: [id])
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  cropTarget           CropType      @default(MAIZE)
  volumeLiters         Float
  concentrationPercent Float         @default(1.0)
  safetyLockStatus     String        @default("UNLOCKED_NOMINAL")
  sensorHash           String
  dmrvRecord           DMRVRecord?
  dispensedAt          DateTime      @default(now())

  @@index([nodeId])
  @@index([userId])
}

model DMRVRecord {
  id                  String        @id @default(uuid())
  dispenseEventId     String        @unique
  dispenseEvent       DispenseEvent @relation(fields: [dispenseEventId], references: [id])
  methaneDestroyedKg  Float
  carbonCapturedKg    Float
  dieselAvoidedKg     Float
  totalCo2eOffsetKg   Float
  hederaHcsTxId       String?
  hederaTokenTxId     String?
  tokenStatus         TokenStatus   @default(PENDING)
  verifiedAt          DateTime?
  createdAt           DateTime      @default(now())

  @@index([tokenStatus])
  @@index([hederaHcsTxId])
}

model SIL3SafetyLog {
  id                 String          @id @default(uuid())
  nodeId             String
  node               Node            @relation(fields: [nodeId], references: [id])
  eventType          SafetyEventType
  sensorReadingsJson Json
  resolved           Boolean         @default(false)
  loggedAt           DateTime        @default(now())
  resolvedAt         DateTime?

  @@index([nodeId])
  @@index([eventType])
}
